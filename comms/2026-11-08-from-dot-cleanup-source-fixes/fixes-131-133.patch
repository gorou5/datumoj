diff --git a/tests/core/test_state_retained_raw.py b/tests/core/test_state_retained_raw.py
new file mode 100644
index 0000000..5d3c7ec
--- /dev/null
+++ b/tests/core/test_state_retained_raw.py
@@ -0,0 +1,128 @@
+"""Retained generations keep required raw across repeated offline rollbacks."""
+
+import hashlib
+from contextlib import closing
+from datetime import datetime
+
+import pytest
+
+from datumoj.rikolto.core import state as state_module
+from datumoj.rikolto.core.manifest import SqliteManifest
+from datumoj.rikolto.core.state import StateManager
+from datumoj.rikolto.testing.samples import T0
+from tests.regressions.test_audit_131 import DAY, publish, raw_key, record
+from tests.regressions.test_audit_131 import archive as archive  # noqa: PLC0414 -- Shared synthetic fixture.
+
+
+@pytest.fixture
+def rolled_back(archive, monkeypatch):
+    snap = record(archive, "rollback-entry")
+    unmarked, _ = publish(archive, T0, monkeypatch)
+    marked, count = publish(archive, T0 + 4 * DAY, monkeypatch)
+    assert count == 1
+
+    class Clock(datetime):
+        @classmethod
+        def now(cls, tz=None):
+            return T0 + 7 * DAY
+
+    monkeypatch.setattr(state_module, "datetime", Clock)
+    # Roll back to an unmarked manifest, publishing a fresh generation that needs raw.
+    first = archive.root / "first-rollback"
+    archive.manager.restore(first, unmarked.generation)
+    first_manager = StateManager(archive.store, first)
+    required = first_manager.push()
+    # Roll back again, this time restoring the mature marker from generation two.
+    second = archive.root / "second-rollback"
+    first_manager.restore(second, marked.generation)
+    manager = StateManager(archive.store, second)
+    current = manager.push()
+    with closing(SqliteManifest(second / "manifest.sqlite")) as manifest:
+        assert manifest.raw_markers()[snap.sha256] == T0 + 4 * DAY
+    return archive, snap, manager, required, current
+
+
+@pytest.mark.parametrize("legacy", [False, True])
+def test_two_rollbacks_preserve_required_raw_of_every_retained_generation(rolled_back, legacy):
+    archive, snap, manager, required, current = rolled_back
+    if legacy:
+        data = (archive.root / "first-rollback" / "manifest.sqlite").read_bytes()
+        sha = hashlib.sha256(data).hexdigest()
+        copy = next(c for c in required.stores if c.name == "manifest.sqlite")
+        copy = copy.model_copy(update={"format": "sqlite", "sha256": sha,
+                                       "key": f"copies/sha256/{sha}", "size_bytes": len(data)})
+        archive.store.put(copy.key, data)
+        required = required.model_copy(update={"stores": [
+            c for c in required.stores if not c.name.startswith("manifest.sqlite")
+        ] + [copy]})
+        archive.store.put(f"generations/{required.generation}.json", required.model_dump_json().encode())
+    report = manager.cleanup(archive.specs, now=T0 + 8 * DAY, check=lambda: None, raw_enabled=True)
+    assert report["failures"] == 0
+    assert report["raw_deleted"] == 0
+    assert archive.store.exists(raw_key(snap))
+    assert {g.generation for g in manager.list()} == {required.generation, current.generation}
+    for generation in manager.list():
+        for mode in ("local", "remote"):
+            target = archive.root / f"restored-{generation.generation}-{mode}"
+            assert manager.restore(target, generation.generation, raw=mode)["verified"]
+    # Protection ends when the last required generation expires, not forever.
+    report = manager.cleanup(archive.specs, now=T0 + 11 * DAY, check=lambda: None, raw_enabled=True)
+    assert report["failures"] == 0
+    assert report["raw_deleted"] == 1
+    assert manager.restore(archive.root / "after-expiry", raw="remote")["verified"]
+
+
+@pytest.mark.parametrize("failure", ["missing", "corrupt", "whole-hash", "timeout"])
+def test_unreadable_retained_manifest_stops_before_any_deletion(rolled_back, monkeypatch, failure):
+    archive, snap, manager, required, _ = rolled_back
+    block = next(c for c in required.stores if c.name.startswith("manifest.sqlite.blocks/"))
+    original_get = archive.store.get
+    timer = [0.0]
+
+    def get(key):
+        found = original_get(key)
+        if key == block.key:
+            if failure == "missing":
+                return None
+            if failure == "corrupt":
+                return b"corrupt", found[1]
+            if failure == "timeout":
+                timer[0] = 600.0
+        return found
+
+    if failure == "whole-hash":
+        required = required.model_copy(update={"stores": [
+            c.model_copy(update={"sha256": "f" * 64, "key": "copies/sha256/" + "f" * 64})
+            if c.name == "manifest.sqlite" else c for c in required.stores
+        ]})
+        archive.store.put(f"generations/{required.generation}.json", required.model_dump_json().encode())
+    before = archive.store.list_objects("")
+    monkeypatch.setattr(archive.store, "get", get)
+    report = manager.cleanup(archive.specs, now=T0 + 8 * DAY, check=lambda: None,
+                             raw_enabled=True, clock=lambda: timer[0])
+    assert report["timed_out"] == (failure == "timeout")
+    assert report["failures"] == (failure != "timeout")
+    assert report["generations_deleted"] == report["copies_deleted"] == report["raw_deleted"] == 0
+    assert archive.store.list_objects("") == before
+    assert archive.store.exists(raw_key(snap))
+
+
+def test_distinct_retained_manifests_are_read_once_without_other_stores(rolled_back, monkeypatch):
+    archive, _, manager, required, current = rolled_back
+    duplicate = required.model_copy(update={"generation": 4, "previous_generation": 3})
+    current = current.model_copy(update={"generation": 5, "previous_generation": 4})
+    for generation in (duplicate, current):
+        archive.store.put(f"generations/{generation.generation}.json", generation.model_dump_json().encode())
+    archive.store.put("current.json", b'{"generation":5}')
+    gets = []
+    original_get = archive.store.get
+
+    def get(key):
+        gets.append(key)
+        return original_get(key)
+
+    monkeypatch.setattr(archive.store, "get", get)
+    report = manager.cleanup(archive.specs, now=T0 + 8 * DAY, check=lambda: None, raw_enabled=True)
+    assert report["failures"] == report["raw_deleted"] == 0
+    blocks = [c.key for c in required.stores if c.name.startswith("manifest.sqlite.blocks/")]
+    assert [key for key in gets if key.startswith(("copies/", "raw/"))] == blocks
