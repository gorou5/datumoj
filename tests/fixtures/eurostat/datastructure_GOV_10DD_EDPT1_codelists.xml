<s:Codelist xmlns:s="http://www.sdmx.org/resources/sdmxml/schemas/v2_1/structure" xmlns:m="http://www.sdmx.org/resources/sdmxml/schemas/v2_1/message" xmlns:c="http://www.sdmx.org/resources/sdmxml/schemas/v2_1/common" agencyID="ESTAT" id="NA_ITEM" isFinal="true" urn="urn:sdmx:org.sdmx.infomodel.codelist.Codelist=ESTAT:NA_ITEM(30.1)" version="30.1"><c:Annotations><c:Annotation><c:AnnotationTitle>2026-07-30T23:00:00+0200</c:AnnotationTitle><c:AnnotationType>LAST_UPDATED</c:AnnotationType></c:Annotation><c:Annotation><c:AnnotationTitle>N</c:AnnotationTitle><c:AnnotationType>DERIVED</c:AnnotationType><c:AnnotationText xml:lang="en">Not derived</c:AnnotationText></c:Annotation></c:Annotations><c:Name xml:lang="en">National accounts indicator (ESA 2010)</c:Name><c:Name xml:lang="de">Volkswirtschaftliche Gesamtrechnungen Indikator (ESVG 2010)</c:Name><c:Name xml:lang="fr">Indicateur des comptes nationaux (SEC 2010)</c:Name><c:Description xml:lang="en">This code list defines different type of national accounts indicators. National accounts are a coherent and consistent set of macroeconomic indicators providing information to analyse the structure of economies and their development over time. The methodology is defined by the European System of National and Regional Accounts 2010, ESA 2010.</c:Description><s:Code id="B1GQ" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=ESTAT:NA_ITEM(30.1).B1GQ"><c:Name xml:lang="en">Gross domestic product at market prices</c:Name><c:Name xml:lang="de">Bruttoinlandsprodukt zu Marktpreisen</c:Name><c:Name xml:lang="fr">Produit intérieur brut aux prix du marché</c:Name></s:Code><s:Code id="B9" urn="urn:sdmx:org.sdmx.infomodel.codelist.Code=ESTAT:NA_ITEM(30.1).B9"><c:Name xml:lang="en">Net lending (+)/net borrowing (-)</c:Name><c:Name xml:lang="de">Finanzierungsüberschuss (+)/Finanzierungsdefizit (-)</c:Name><c:Name xml:lang="fr">Capacité de financement (+)/besoin de financement (-)</c:Name></s:Code><s:Code id="GD" urn="urn:sdmx:org.sdmx.infomode