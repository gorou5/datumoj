# 本地开发环境变量（绝不提交真实值）
# 复制为 .env 后填入：cp .env.example .env

# Cloudflare（部署用，见 docs/architecture.md §4）
CLOUDFLARE_API_TOKEN=your-token-here
CLOUDFLARE_ACCOUNT_ID=your-account-id-here

# 网络存储：优先使用 NAS 上的 S3 兼容服务；只在局域网或 VPN 内访问，不开公网端口。
# 状态使用下面的 S3 配置；设 DATUMOJ_RAW_BACKEND=s3 时 raw 也写入 S3，库和索引仍在 DATUMOJ_DATA_DIR。
DATUMOJ_RAW_BACKEND=local
# NAS 示例值均为虚构占位符：
# DATUMOJ_RAW_BACKEND=s3
# DATUMOJ_S3_ENDPOINT=http://nas.example:9000
# DATUMOJ_S3_BUCKET=your-bucket-name
# DATUMOJ_S3_PREFIX=datumoj
# DATUMOJ_S3_REGION=us-east-1
# DATUMOJ_S3_ACCESS_KEY_ID=your-key-id-here
# DATUMOJ_S3_SECRET_ACCESS_KEY=your-secret-here

# R2 旧名仍兼容；与通用名同时设置时，每一对的值必须相同。
# DATUMOJ_RAW_BACKEND=s3
# R2_ENDPOINT=https://account-id.example.r2.cloudflarestorage.com
# DATUMOJ_S3_BUCKET=your-bucket-name
# DATUMOJ_S3_PREFIX=datumoj
# DATUMOJ_S3_REGION=auto
# R2_ACCESS_KEY_ID=your-key-id-here
# R2_SECRET_ACCESS_KEY=your-secret-here
