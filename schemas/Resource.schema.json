{
  "additionalProperties": false,
  "description": "数据集下的资源文件或端点。",
  "properties": {
    "resource_id": {
      "minLength": 1,
      "title": "Resource Id",
      "type": "string"
    },
    "dataset_key": {
      "pattern": "^[a-z]{2,4}(?:-[a-z0-9]+)+:\\S(?:.*\\S)?$",
      "title": "Dataset Key",
      "type": "string"
    },
    "source_id": {
      "pattern": "^[a-z]{2,4}(?:-[a-z0-9]+)+$",
      "title": "Source Id",
      "type": "string"
    },
    "url": {
      "title": "Url",
      "type": "string"
    },
    "name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Name"
    },
    "format": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Format"
    },
    "media_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Media Type"
    },
    "license": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "License"
    },
    "size": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Size"
    },
    "modified_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Modified At"
    }
  },
  "required": [
    "resource_id",
    "dataset_key",
    "source_id",
    "url"
  ],
  "title": "Resource",
  "type": "object"
}
