{
  "$defs": {
    "Outflow": {
      "description": "Output permission; absent permissions must be treated as no_outflow.",
      "enum": [
        "raw_ok",
        "derived_only",
        "no_outflow"
      ],
      "title": "Outflow",
      "type": "string"
    },
    "Redistribution": {
      "enum": [
        "allowed",
        "forbidden",
        "unverified"
      ],
      "title": "Redistribution",
      "type": "string"
    },
    "UsageScope": {
      "enum": [
        "internal_only",
        "redistributable"
      ],
      "title": "UsageScope",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "许可。缺省禁止数据流出及云端模型处理；旧字段必须与 raw_ok 保持一致。",
  "properties": {
    "name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Name"
    },
    "url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Url"
    },
    "attribution": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Attribution"
    },
    "usage_scope": {
      "$ref": "#/$defs/UsageScope",
      "default": "internal_only"
    },
    "redistribution": {
      "$ref": "#/$defs/Redistribution",
      "default": "unverified"
    },
    "outflow": {
      "$ref": "#/$defs/Outflow",
      "default": "no_outflow"
    },
    "cloud_model_ok": {
      "default": false,
      "title": "Cloud Model Ok",
      "type": "boolean"
    },
    "verified_at": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Verified At"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    }
  },
  "title": "LicenseInfo",
  "type": "object"
}
