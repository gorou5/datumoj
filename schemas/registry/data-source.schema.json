{"$id":"https://github.com/gorou5/datumoj/schemas/data-source.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":true,"description":"Machine-readable description of an official government public data source. Unknown fields must be \"unknown\", never invented.","properties":{"access_detail":{"description":"How to access: endpoint, docs URL, query params","type":"string"},"access_method":{"enum":["api","download","web","bulk","other"],"type":"string"},"auth_required":{"type":"boolean"},"auth_type":{"description":"e.g. none / api-key / oauth","type":"string"},"country_region":{"description":"Country or region, e.g. JP / US / EU. Use \"unknown\" if unclear.","type":"string"},"data_format":{"enum":["json","xml","csv","html","pdf","web","api","bulk-download","other","unknown"],"type":"string"},"dataset_id":{"description":"Dataset or collection identifier at the source","type":"string"},"error_handling":{"type":"string"},"id":{"description":"Globally unique kebab-case identifier, e.g. jp-nta-houjin-bangou","pattern":"^[a-z0-9]+(-[a-z0-9]+)*$","type":"string"},"inputs":{"items":{"additionalProperties":true,"properties":{"description":{"type":"string"},"name":{"type":"string"},"required":{"type":"boolean"},"type":{"type":"string"}},"required":["name"],"type":"object"},"type":"array"},"known_limits":{"type":"string"},"last_verified":{"description":"YYYY-MM-DD of last successful verification against the official source","pattern":"^([0-9]{4}-[0-9]{2}-[0-9]{2}|unknown)$","type":"string"},"license":{"additionalProperties":true,"properties":{"allows_redistribution":{"description":"true/false/\"unknown\"","type":["boolean","string"]},"name":{"type":"string"},"requires_attribution":{"type":["boolean","string"]},"url":{"format":"uri","type":"string"}},"required":["name"],"type":"object"},"maintainer":{"type":"string"},"name":{"minLength":1,"type":"string"},"name_en":{"type":"string"},"official_url":{"format":"uri","type":"string"},"outputs":{"description":"Output format description","type":"string"},"publisher":{"description":"Publishing government agency, e.g. 日本国税庁","type":"string"},"rate_limit":{"description":"Known request frequency limits, or \"unknown\"","type":"string"},"status":{"default":"experimental","enum":["active","experimental","deprecated","unknown"],"type":"string"},"update_mechanism":{"type":"string"}},"required":["id","name","country_region","publisher","official_url","access_method"],"title":"Government public data source description","type":"object"}