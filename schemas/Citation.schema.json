{
  "$defs": {
    "Period": {
      "additionalProperties": false,
      "description": "统计期间；label 保留原文（如“令和2年度”“2020年10月1日現在”）。",
      "properties": {
        "start": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        },
        "end": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "label"
      ],
      "title": "Period",
      "type": "object"
    },
    "TimeBasis": {
      "description": "出处的时间口径。来源不公布数据日期时用 no_data_date，绝不拿抓取日顶替。",
      "enum": [
        "period",
        "published",
        "effective",
        "no_data_date"
      ],
      "title": "TimeBasis",
      "type": "string"
    },
    "UsageScope": {
      "enum": [
        "internal_only",
        "redistributable"
      ],
      "title": "UsageScope",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "出处 = source_id + resource_url + snapshot_sha256 + fetched_at + locator，外加时间口径与许可。\n\nfetched_at 只是抓取日，永远不能当数据日期用。",
  "properties": {
    "source_id": {
      "pattern": "^[a-z]{2,4}(?:-[a-z0-9]+)+$",
      "title": "Source Id",
      "type": "string"
    },
    "resource_url": {
      "title": "Resource Url",
      "type": "string"
    },
    "snapshot_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Snapshot Sha256",
      "type": "string"
    },
    "fetched_at": {
      "format": "date-time",
      "title": "Fetched At",
      "type": "string"
    },
    "locator": {
      "pattern": "^(?:art|para|item|suppl|table|page|sheet|cell|row|entry|section|feature|member)=(?:[^%;=\\x00-\\x1f\\x7f]|%(?:25|3B|3D))+(?:;(?:art|para|item|suppl|table|page|sheet|cell|row|entry|section|feature|member)=(?:[^%;=\\x00-\\x1f\\x7f]|%(?:25|3B|3D))+)*$",
      "title": "Locator",
      "type": "string"
    },
    "published_at": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Published At"
    },
    "effective_at": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Effective At"
    },
    "period": {
      "anyOf": [
        {
          "$ref": "#/$defs/Period"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "license": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "License"
    },
    "attribution": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Attribution"
    },
    "usage_scope": {
      "anyOf": [
        {
          "$ref": "#/$defs/UsageScope"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "time_basis": {
      "$ref": "#/$defs/TimeBasis"
    }
  },
  "required": [
    "source_id",
    "resource_url",
    "snapshot_sha256",
    "fetched_at",
    "locator",
    "time_basis"
  ],
  "title": "Citation",
  "type": "object"
}
