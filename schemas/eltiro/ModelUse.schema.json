{
  "additionalProperties": false,
  "properties": {
    "provider": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Provider",
      "type": "string"
    },
    "model": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "version": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Version",
      "type": "string"
    },
    "tier": {
      "enum": [
        "none",
        "low",
        "medium",
        "high"
      ],
      "title": "Tier",
      "type": "string"
    }
  },
  "required": [
    "provider",
    "model",
    "version",
    "tier"
  ],
  "title": "ModelUse",
  "type": "object"
}
