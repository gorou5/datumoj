httpserver = <HTTPServer host=localhost port=59935>, failure = 'http'

    @pytest.mark.parametrize("failure", ["http", "network"])
    def test_head_retries_before_fallback_get(site, httpserver, failure):
        if failure == "http":
            httpserver.expect_ordered_request("/file.pdf", method="HEAD").respond_with_data(status=503)
        else:
            def disconnect(request):
                raise httpx.ConnectError("synthetic HEAD connection failure", request=request)
    
            original = site.fetcher  # Inject one failure at the same transport boundary as a real socket error.
    
            def with_failure(**kwargs):
                client = original(**kwargs)
                send = client._client.send
    
                def send_once(request, **options):
                    if request.method == "HEAD" and not getattr(client, "failed", False):
                        client.failed = True
                        site.sent.append(("HEAD", request.url.path, site.clock(), request.headers))
                        disconnect(request)
                    return send(request, **options)
    
                client._client.send = send_once
                return client
    
            site.fetcher = with_failure
        site.route(status=405)
        site.route(method="GET")
        result = site.fetcher(max_retries=1, backoff=3).fetch(URL, last_modified=LM, size=4, head_probe=True)
